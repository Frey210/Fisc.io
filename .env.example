# Fisc.io Environment Variables
# Copy this to .env.local for local development.
# Do NOT commit .env.local to Git.

# Supabase (From Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJh...
SUPABASE_SERVICE_ROLE_KEY=eyJh...

# Telegram Bot (From @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Telegram Webhook Security (Secret token for X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=fisc_secure_webhook_secret_random_string

# App Base URL (e.g. https://fisc.farlabs.my.id or ngrok URL for local bot testing)
NEXT_PUBLIC_APP_URL=http://localhost:3000

